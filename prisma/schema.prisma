// AutoPro Garage — Prisma schema (Neon Postgres)
generator client {
  provider = "prisma-client-js"
  // "native" builds for this machine; the rhel target is what Netlify
  // Functions run on (Amazon Linux). Without it the deployed site throws
  // "Query engine library for current platform could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  ENGINE_DIAGNOSTICS
  PANEL_BEATING
  WHEEL_ALIGNMENT
  BRAKE_SUSPENSION
  AC_SERVICING
  ELECTRICAL
  PRE_PURCHASE_INSPECTION
  INSURANCE_CLAIM
  OTHER
}

enum Role {
  ADMIN
  STAFF
}

model Booking {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String?
  vehicleMake    String
  vehicleModel   String
  vehicleYear    Int?
  service        ServiceType
  preferredDate  DateTime
  notes          String?
  status         BookingStatus @default(PENDING)
  consentPrivacy Boolean       @default(false)
  consentMarket  Boolean       @default(false)
  ipHash         String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([phone])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
}

/// Key/value store for editable site content (WhatsApp number, address, hours).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Uploaded images live in Postgres so the same code path works locally and on
/// Netlify, whose filesystem is read-only. Served via /api/media/[id] with a
/// long cache. If the gallery ever grows past ~100 images, move to object
/// storage and keep only the URL here.
model MediaAsset {
  id        String   @id @default(cuid())
  mimeType  String
  bytes     Int
  data      Bytes
  alt       String?
  createdAt DateTime @default(now())

  galleryBefore GalleryItem[] @relation("BeforeImage")
  galleryAfter  GalleryItem[] @relation("AfterImage")
}

model GalleryItem {
  id        String   @id @default(cuid())
  tag       String
  title     String
  beforeUrl String?
  afterUrl  String?
  beforeId  String?
  afterId   String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  before MediaAsset? @relation("BeforeImage", fields: [beforeId], references: [id], onDelete: SetNull)
  after  MediaAsset? @relation("AfterImage",  fields: [afterId],  references: [id], onDelete: SetNull)

  @@index([sortOrder])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  href      String
  color     String   @default("#5A6069")
  mark      String   @default("dot")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model NewsletterLead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  consent   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CookieConsent {
  id         String   @id @default(cuid())
  anonId     String   @unique
  necessary  Boolean  @default(true)
  analytics  Boolean  @default(false)
  marketing  Boolean  @default(false)
  version    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
