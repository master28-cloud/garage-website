# ----- Neon Postgres -----
# Get this from https://console.neon.tech after creating a project
# Use the "Pooled" connection string for Vercel serverless
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Direct (non-pooled) URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ----- Admin auth -----
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="replace-with-64-char-random-hex"
ADMIN_EMAIL="admin@autoprogarage.co.ke"
# Bcrypt hash of your admin password.
# Generate: `node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"`
# IMPORTANT: escape every $ as \$ — Next.js expands .env values, so a raw $2a$10$
# bcrypt hash gets silently blanked out and every login fails.
ADMIN_PASSWORD_HASH="\$2a\$10\$replace.with.bcrypt.hash"

# ----- WhatsApp -----
NEXT_PUBLIC_WHATSAPP_NUMBER="254727718981"

# ----- Site -----
NEXT_PUBLIC_SITE_URL="https://autoprogarage.co.ke"
